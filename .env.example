## Copy to ".env" (same folder as docker-compose.yml) to configure `docker compose up`.
## Every value has a working default for local use; set these for anything beyond that.

JWT_SECRET=change-me-in-prod
PUBLIC_URL=http://localhost:5174
MAIL_FROM=FutureLife Portal <no-reply@futurelife.local>

# Needed for client lookup and staff lists; leave blank to run without those
DAFTRA_SUBDOMAIN=
DAFTRA_API_KEY=
