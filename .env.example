## Copy to ".env" (same folder as docker-compose.yml) to configure `docker compose up`.
## Every value has a working default for local use; set these for anything beyond that.

JWT_SECRET=change-me-in-prod
PUBLIC_URL=http://localhost:5174
MAIL_FROM=FutureLife Portal <no-reply@futurelife.local>

# A stand-in for Daftra inside the portal: nothing reaches the live account, and no Daftra key is
# needed. On unless set to false, so a portal on your machine cannot write to the live account by
# accident. Set it to false to work against the live account, with the two values below.
# Apply a change with `docker compose up -d backend` (`restart` keeps the old value).
DAFTRA_FAKE=true

# Needed for client lookup and staff lists; leave blank to run without those
DAFTRA_SUBDOMAIN=
DAFTRA_API_KEY=

# true puts the إثبات الدفع an approved request carries on its invoice in Daftra as an attachment
DAFTRA_SEND_PAYMENT_PROOF=false
# Marks what a request made in Daftra, so a retry finds it. Each portal on one Daftra account
# needs its own: the server uses PORTAL, a portal on your machine should use something else.
DAFTRA_MARKER_PREFIX=DEV
