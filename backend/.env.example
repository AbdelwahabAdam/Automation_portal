DATABASE_URL=postgresql+psycopg://portal:portal_dev@localhost:5433/portal
JWT_SECRET=change-me

# Address users open the portal at; used in the links sent by email
PUBLIC_URL=http://localhost:5174

# Email. These values are the local mail catcher from docker-compose (inbox at http://localhost:8026).
# For real email use your provider's server, e.g. SMTP_PORT=587, SMTP_STARTTLS=true, SMTP_USER and SMTP_PASSWORD.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_STARTTLS=false
MAIL_FROM=FutureLife Portal <no-reply@futurelife.local>
